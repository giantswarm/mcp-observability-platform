{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "affinity": {
            "type": "object",
            "additionalProperties": false
        },
        "autoscaling": {
            "type": "object",
            "description": "- Autoscaling (both opt-in, off by default) ---",
            "additionalProperties": false,
            "properties": {
                "hpa": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "behavior": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "maxReplicas": {
                            "type": "integer"
                        },
                        "minReplicas": {
                            "type": "integer"
                        },
                        "targetCPUUtilizationPercentage": {
                            "type": "integer"
                        },
                        "targetMemoryUtilizationPercentage": {
                            "type": "integer"
                        }
                    }
                },
                "vpa": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "resourcePolicy": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "updateMode": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "containerSecurityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                }
            }
        },
        "extraEnvFrom": {
            "type": "array"
        },
        "extraEnvVars": {
            "type": "array"
        },
        "fullnameOverride": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as this schema would otherwise not allow Helm's special 'global' values key."
        },
        "grafana": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "authMode": {
                    "type": "string"
                },
                "existingSecret": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "httpRoute": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "annotations": {
                    "type": "object",
                    "additionalProperties": false
                },
                "enabled": {
                    "type": "boolean"
                },
                "hostnames": {
                    "type": "array"
                },
                "matches": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "path": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "type": {
                                        "type": "string"
                                    },
                                    "value": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "parentRefs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "namespace": {
                                "type": "string"
                            },
                            "sectionName": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "pullPolicy": {
                    "type": "string"
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "imagePullSecrets": {
            "type": "array"
        },
        "mcp": {
            "type": "object",
            "description": "- MCP application configuration --- All of these become env vars on the deployment. Secrets are mounted from existing Kubernetes Secrets — do not put secret values inline here.",
            "additionalProperties": false,
            "properties": {
                "debug": {
                    "type": "boolean"
                },
                "transport": {
                    "type": "string"
                }
            }
        },
        "nameOverride": {
            "type": "string"
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "egress": {
                    "type": "array"
                },
                "enabled": {
                    "type": "boolean"
                },
                "ingress": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "ports": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "port": {
                                            "type": "string"
                                        },
                                        "protocol": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "policyTypes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "nodeSelector": {
            "type": "object",
            "additionalProperties": false
        },
        "oauth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowInsecureHTTP": {
                    "type": "boolean"
                },
                "allowPublicClientRegistration": {
                    "type": "boolean"
                },
                "dex": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "clientId": {
                            "type": "string"
                        },
                        "existingSecret": {
                            "type": "string"
                        },
                        "issuerUrl": {
                            "type": "string"
                        }
                    }
                },
                "encryption": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "existingSecret": {
                            "type": "string"
                        }
                    }
                },
                "issuer": {
                    "type": "string"
                },
                "storage": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "backend": {
                            "type": "string"
                        },
                        "valkey": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "addr": {
                                    "type": "string"
                                },
                                "existingSecret": {
                                    "type": "string"
                                },
                                "tls": {
                                    "type": "boolean"
                                }
                            }
                        }
                    }
                },
                "trustedAudiences": {
                    "type": "array"
                },
                "trustedIssuers": {
                    "type": "array"
                },
                "trustedRedirectSchemes": {
                    "type": "array"
                }
            }
        },
        "otel": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "endpoint": {
                    "type": "string"
                },
                "extraEnv": {
                    "type": "array"
                },
                "insecure": {
                    "type": "boolean"
                },
                "protocol": {
                    "type": "string"
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "additionalProperties": false
        },
        "podDisruptionBudget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "minAvailable": {
                    "type": "integer"
                }
            }
        },
        "podLabels": {
            "type": "object",
            "additionalProperties": false
        },
        "podSecurityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "priorityClassName": {
            "type": "string"
        },
        "provider": {
            "type": "string"
        },
        "rbac": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "create": {
                    "type": "boolean"
                }
            }
        },
        "replicas": {
            "type": "integer"
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "runtime": {
            "type": "object",
            "description": "- Runtime tunables (ConfigMap-backed) --- All fields here surface as env vars on the deployment via envFrom.",
            "additionalProperties": false,
            "properties": {
                "maxResponseBytes": {
                    "type": "integer"
                },
                "toolTimeout": {
                    "type": "string"
                }
            }
        },
        "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string"
                },
                "annotations": {
                    "type": "object",
                    "additionalProperties": false
                },
                "metricsPort": {
                    "type": "integer"
                },
                "port": {
                    "type": "integer"
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "annotations": {
                    "type": "object",
                    "additionalProperties": false
                },
                "create": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "serviceMonitor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "interval": {
                    "type": "string"
                },
                "labels": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "observability.giantswarm.io/tenant": {
                            "type": "string"
                        }
                    }
                },
                "metricRelabelings": {
                    "type": "array"
                },
                "relabelings": {
                    "type": "array"
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "tolerations": {
            "type": "array"
        },
        "tools": {
            "type": "object",
            "description": "- Tool registration --- `disabled` is a list of MCP tool names to skip at startup, e.g. [\"alerting_manage_rules\", \"get_panel_image\"]. Names match the tool identifier exposed in tools/list. Empty = all tools registered.",
            "additionalProperties": false,
            "properties": {
                "disabled": {
                    "type": "array"
                }
            }
        },
        "topologySpreadConstraints": {
            "type": "array"
        }
    }
}
